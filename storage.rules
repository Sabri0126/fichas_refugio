rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null && request.auth.uid in [
        'yOUYuJ0handglgCltQU4cqnURGn1', // sabribarrion@
        'V4ok42JUpFXFolIMiEXEFuGzPmf1', // chiky.14.g@
        'coEjVBdW9XVPaHCMdrOG3wWYtVs2'  // marilyn.vespoli@
      ];
    }
    // App uploads via putFile without metadata: Android -> image/jpeg, Windows -> application/octet-stream
    function validUpload() {
      return request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/octet-stream');
    }
    match /fotos_perfil/{file} {
      allow read: if true;
      allow create, update: if isStaff() && validUpload();
      allow delete: if isStaff();
    }
    match /galeria_perros/{file} {
      allow read: if true;
      allow create, update: if isStaff() && validUpload();
      allow delete: if isStaff();
    }
    // Estudios medicos (fase 4): solo el personal. La app sube a estudios_medicos/{perroId}/{archivo}.
    // Archivos de un solo segmento o rutas mas profundas caen en la regla final que niega todo.
    match /estudios_medicos/{perroId}/{archivo} {
      allow read: if isStaff();
      allow create, update: if isStaff() && validUpload();
      allow delete: if isStaff();
    }
    match /{other=**} { allow read, write: if false; }
  }
}
