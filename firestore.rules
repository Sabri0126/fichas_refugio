rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null && request.auth.uid in [
        'yOUYuJ0handglgCltQU4cqnURGn1', // sabribarrion@
        'V4ok42JUpFXFolIMiEXEFuGzPmf1', // chiky.14.g@
        'coEjVBdW9XVPaHCMdrOG3wWYtVs2'  // marilyn.vespoli@
      ];
    }
    match /perros/{id} {
      allow read: if true;          // visitor mode
      allow write: if isStaff();
    }
    match /dispositivos/{token} {
      allow read: if false;
      allow create, update: if isStaff() && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /notificaciones/{id} {
      allow read: if isStaff();
      allow write: if false;        // Cloud Functions use Admin SDK (bypass rules)
    }
    match /config/{doc} { allow read, write: if false; }
  }
}
